# ShadowServe AI — environment configuration
# Copy to .env and adjust for your environment.

SHADOWSERVE_PRODUCTION_MODEL_URL=http://localhost:8001
SHADOWSERVE_CHALLENGER_MODEL_URL=http://localhost:8002
SHADOWSERVE_PRODUCTION_MODEL_VERSION=v1.2.0
SHADOWSERVE_CHALLENGER_MODEL_VERSION=v1.3.0

SHADOWSERVE_CANARY_WEIGHT=0.10
SHADOWSERVE_SHADOW_ENABLED=true

SHADOWSERVE_KS_DRIFT_THRESHOLD=0.05
SHADOWSERVE_PSI_DRIFT_THRESHOLD=0.20
SHADOWSERVE_ROLLBACK_ON_DRIFT=true

SHADOWSERVE_REDIS_URL=redis://localhost:6379/0
SHADOWSERVE_DATABASE_URL=postgresql+asyncpg://shadowserve:shadowserve@localhost:5432/shadowserve

# Generate a strong secret for production
SHADOWSERVE_JWT_SECRET=change-me-in-production
SHADOWSERVE_JWT_ALGORITHM=HS256
